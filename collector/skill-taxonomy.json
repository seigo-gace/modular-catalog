{
  "schemaVersion": 1,
  "name": "skill-selection-taxonomy",
  "purpose": "Skillの分母を広げ、開発要求ごとに既存Skillを検索・比較・選択・編成し、不足時だけ新規開発へ進むための横断能力分類。収集カテゴリ名・件数はCollection Configから読み込み、この索引では固定しない。",
  "domains": [
    {"id": "understanding-analysis", "name_ja": "理解・解析", "purpose": "入力、構造、責務、意図、矛盾を理解する"},
    {"id": "search-evidence", "name_ja": "検索・根拠収集", "purpose": "Sourceを探索しEvidenceと鮮度を確認する"},
    {"id": "compression-context", "name_ja": "圧縮・Context管理", "purpose": "Token、Prompt、Contextを意味保持したまま最適化する"},
    {"id": "reasoning-planning-decision", "name_ja": "推論・判断・計画", "purpose": "分解、比較、反対視点、優先順位、意思決定を行う"},
    {"id": "language-japanese", "name_ja": "言語・日本語処理", "purpose": "多言語、日本語、敬語、文体、表記を処理する"},
    {"id": "document-content", "name_ja": "文書・Content生成", "purpose": "仕様書、設計書、Report、Template、Media用Contentを作る"},
    {"id": "code-software-engineering", "name_ja": "Code・Software Engineering", "purpose": "Code生成、理解、設計、Refactoring、再構築を行う"},
    {"id": "testing-debug-quality", "name_ja": "Test・Debug・品質", "purpose": "Test、Debug、Review、Gate、回帰検証を行う"},
    {"id": "data-processing-analytics", "name_ja": "Data処理・分析", "purpose": "変換、集計、統計、可視化、予測を行う"},
    {"id": "memory-kb-rag", "name_ja": "Memory・KB・RAG", "purpose": "Memory、Knowledge、Retrieval、KBを構築・運用する"},
    {"id": "agent-orchestration", "name_ja": "Agent・Orchestration", "purpose": "複数Skill、AI、Tool、Workflowを制御する"},
    {"id": "api-tool-integration", "name_ja": "API・Tool・外部連携", "purpose": "API、Webhook、Connector、Adapterで外部Systemと接続する"},
    {"id": "automation-long-running", "name_ja": "自動化・長時間実行", "purpose": "Checkpoint、Resume、Queue、長時間Taskを扱う"},
    {"id": "infrastructure-reliability", "name_ja": "Infrastructure・運用", "purpose": "Runtime、CI、監視、復旧、信頼性を扱う"},
    {"id": "security-risk", "name_ja": "Security・Risk", "purpose": "脆弱性、権限、Secret、Privacy、Riskを扱う"},
    {"id": "ai-model-specific", "name_ja": "各AI・各Model固有能力", "purpose": "Claude、GPT、Gemini等の固有能力と制御を扱う"},
    {"id": "ui-ux-design", "name_ja": "UI・UX・Design", "purpose": "UI、UX、情報設計、Accessibilityを扱う"},
    {"id": "business-domain-operations", "name_ja": "業務・専門分野", "purpose": "事業、販売、財務、運用、専門Domainの処理を扱う"}
  ],
